{%- assign col = collections[section.settings.collection] -%}

<div class="section-pad">
  <div class="section-header">
    <h2 class="section-headline reveal">
      {{ section.settings.heading | default: col.title }}
    </h2>
    {%- if section.settings.subtext != blank -%}
      <p class="section-sub reveal reveal-delay-1">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="product-grid reveal reveal-delay-2">
    {%- for product in col.products limit: section.settings.product_limit -%}
      {%- render 'product-card', product: product, index: forloop.index -%}
    {%- else -%}
      <p style="padding:48px;color:var(--ink-dim);">No products found in this collection.</p>
    {%- endfor -%}
  </div>

  {%- if section.settings.view_all_label != blank -%}
    <div style="text-align:center;margin-top:48px;">
      <a href="{{ col.url }}" class="btn btn-outline">{{ section.settings.view_all_label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
