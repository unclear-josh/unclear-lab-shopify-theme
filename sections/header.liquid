<header class="site-header" id="site-header" role="banner">
  <a href="{{ routes.root_url }}" class="header-logo">
    {%- if section.settings.logo != blank -%}
      <img
        src="{{ section.settings.logo | image_url: width: 300 }}"
        alt="{{ shop.name }}"
        width="{{ section.settings.logo_width }}"
        height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
        loading="eager"
        style="display:block;width:{{ section.settings.logo_width }}px;height:auto;"
      >
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>

  <nav class="header-nav" aria-label="Main navigation">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" class="header-nav-link"
        {%- if link.active %} aria-current="page"{% endif -%}>
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>

  <div class="header-actions">
    <a href="{{ routes.cart_url }}" class="header-cart-link" aria-label="Cart">
      Cart
      {%- if cart.item_count > 0 -%}
        <span class="cart-count">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
    <button
      class="header-hamburger"
      id="nav-toggle"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
  <a href="{{ routes.root_url }}" class="header-logo" style="margin-bottom:40px;">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" style="width:{{ section.settings.logo_width }}px;height:auto;" loading="eager">
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>
  {%- for link in section.settings.menu.links -%}
    <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
  {%- endfor -%}
  <a href="{{ routes.cart_url }}" class="mobile-nav-link">
    Cart {%- if cart.item_count > 0 -%}({{ cart.item_count }}){%- endif -%}
  </a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
