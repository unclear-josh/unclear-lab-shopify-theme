<div class="section-pad">
  <div class="section-header">
    <h2 class="section-headline reveal">
      {{ section.settings.heading }}
    </h2>
    {%- if section.settings.subtext != blank -%}
      <p class="section-sub reveal reveal-delay-1">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="features-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}
        <div class="feature-card reveal" {{ block.shopify_attributes }}>
          <p class="feature-index">
            {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
          </p>
          <h3 class="feature-title">{{ block.settings.title }}</h3>
          <p class="feature-desc">{{ block.settings.description }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two materials, one purpose"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
