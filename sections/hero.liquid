<section class="hero">
  <div class="hero-inner">

    {%- if section.settings.tag != blank -%}
      <p class="section-tag hero-tag reveal">{{ section.settings.tag }}</p>
    {%- endif -%}

    <h1 class="hero-heading reveal reveal-delay-1">
      {%- if section.settings.heading_line1 != blank -%}
        {{ section.settings.heading_line1 }}
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <br><em>{{ section.settings.heading_line2 }}</em>
      {%- endif -%}
    </h1>

    {%- if section.settings.body != blank -%}
      <p class="hero-body reveal reveal-delay-2">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="hero-actions reveal reveal-delay-3">
        <a href="{{ section.settings.cta_url }}" class="btn btn-dark">
          {{ section.settings.cta_label }}
        </a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="btn btn-outline">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag line",
      "default": "New things, made well"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — line 1",
      "default": "What's out"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — line 2 (italic)",
      "default": "this month?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Have a look"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
