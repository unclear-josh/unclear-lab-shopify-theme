<section class="hero">
  <div class="hero-inner">

    {%- if section.settings.tag != blank -%}
      <p class="section-tag hero-tag reveal">{{ section.settings.tag }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="reveal reveal-delay-1">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="hero-body reveal reveal-delay-2">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="hero-actions reveal reveal-delay-3">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn-dark">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_url }}" class="btn btn-outline">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag line (mono, above heading)",
      "default": "Unclear Lab"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (use <em> for italic accent)",
      "default": "<p>Nothing but<br><em>the cup</em></p>"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Plant-derived lyocell filters for the Hario V60. No paper taste, no pre-rinse, no compromise."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
