<div class="product-page">

  <!-- Gallery -->
  <div class="product-gallery">
    {%- if product.featured_image -%}
      <img
        id="product-main-image"
        src="{{ product.featured_image | image_url: width: 1200 }}"
        alt="{{ product.featured_image.alt | escape }}"
        class="product-gallery-main"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="eager"
      >
      {%- if product.images.size > 1 -%}
        <div class="product-gallery-thumbs">
          {%- for image in product.images limit: 5 -%}
            <button
              class="product-gallery-thumb {% if forloop.first %}active{% endif %}"
              data-full="{{ image | image_url: width: 1200 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | image_url: width: 96 }}"
                alt="{{ image.alt | escape }}"
                width="48"
                height="48"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
        <span style="font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.28em;text-transform:uppercase;color:var(--ink-faint);">No image</span>
      </div>
    {%- endif -%}
  </div>

  <!-- Detail -->
  <div class="product-detail">

    <div class="product-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span>/</span>
      {{ product.title }}
    </div>

    <h1 class="product-title">{{ product.title }}</h1>

    <p class="product-price">
      {%- if product.price_varies -%}
        From {{ product.price_min | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        <del style="color:var(--ink-faint);margin-left:12px;">{{ product.compare_at_price | money }}</del>
      {%- endif -%}
    </p>

    {%- if product.description != blank -%}
      <div class="product-desc rte">{{ product.description }}</div>
    {%- endif -%}

    {%- assign current_variant = product.selected_or_first_available_variant -%}

    <script>
      window.productVariants = {{ product.variants | json }};
    </script>

    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="product-form">

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="product-form-group">
            <label class="product-form-label">{{ option.name }}</label>
            <div class="product-variants" data-option-index="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="variant-btn{% if option.selected_value == value %} selected{% endif %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">

      <div class="product-atc" id="product-atc">
        {%- if current_variant.available -%}
          <button type="submit" name="add" class="btn btn-dark btn-full">
            Add to cart
          </button>
        {%- else -%}
          <button type="button" class="btn btn-outline btn-full" disabled>
            Sold out
          </button>
        {%- endif -%}
      </div>

    </form>

    <div class="product-meta">
      {%- for block in section.blocks -%}
        {%- if block.type == 'meta_item' -%}
          <div class="product-meta-item" {{ block.shopify_attributes }}>
            <span class="product-meta-icon">{{ block.settings.label }}</span>
            <span class="product-meta-text">{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "meta_item",
      "name": "Meta item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add product detail here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
