<section class="notify-section" id="email-cta">
  <div class="notify-section-inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="notify-heading reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="notify-form reveal reveal-delay-1" data-email-form data-confirm="cta-confirm">
      <input
        type="email"
        class="input notify-input"
        placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
        aria-label="Email address"
      >
      <button type="button" class="btn btn-dark">
        {{ section.settings.button_label | default: 'Notify me' }}
      </button>
    </div>
    <p class="cta-confirm notify-confirm" id="cta-confirm">
      {{ section.settings.confirm_text | default: "You're on the list — we'll be in touch" }}
    </p>

  </div>
</section>

{% schema %}
{
  "name": "Email notify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first to know"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "confirm_text",
      "label": "Confirmation text",
      "default": "You're on the list — we'll be in touch"
    }
  ],
  "presets": [
    {
      "name": "Email notify"
    }
  ]
}
{% endschema %}
